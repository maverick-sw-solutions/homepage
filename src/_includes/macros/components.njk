{% macro btn(href, icon, label, variant="primary") %}
<a href="{{ href }}" class="btn btn--{{ variant }}"><i class="{{ icon }}"></i> {{ label }}<span class="arrow" aria-hidden="true"></span></a>
{% endmacro %}

{% macro contactBtn(icon, label, variant="primary", subject="") %}
<button type="button" class="btn btn--{{ variant }}" data-contact-open{% if subject %} data-contact-subject="{{ subject }}"{% endif %}><i class="{{ icon }}"></i> {{ label }}<span class="arrow" aria-hidden="true"></span></button>
{% endmacro %}

{% macro projectRow(href, idx, title, badgeText, badgeVariant, desc, image=none) %}
<a href="{{ href }}" class="prj" data-anim="rise">
  <span class="prj-inner">
    <span class="prj-idx">{{ idx }}</span>
    <span class="prj-name">{{ title }}</span>
    <span class="prj-thumb">
      {% if image %}<img src="{{ image }}" alt="" loading="lazy">{% else %}<span class="plate"><b>{{ title }}</b></span>{% endif %}
    </span>
    <span class="prj-side">
      <span class="prj-status prj-status--{{ badgeVariant }}">{{ badgeText }}</span>
      <span class="prj-desc">{{ desc }}</span>
    </span>
  </span>
</a>
{% endmacro %}

{% macro featureCard(icon, title, text) %}
<div class="feature-card">
  <div class="feature-card__icon"><i class="{{ icon }}"></i></div>
  {% if title %}<h3>{{ title }}</h3>{% endif %}
  <p>{{ text }}</p>
</div>
{% endmacro %}

{% macro audienceCard(icon, title, text, featured=false, muted=false) %}
<div class="audience-card{% if featured %} audience-card--featured{% endif %}{% if muted %} audience-card--muted{% endif %}">
  <i class="{{ icon }}"></i>
  <h3>{{ title }}</h3>
  <p>{{ text }}</p>
</div>
{% endmacro %}

{% macro step(num, text) %}
<div class="step">
  <div class="step__num">{{ num }}</div>
  <p class="step__text">{{ text | safe }}</p>
</div>
{% endmacro %}

{% macro pill(text) %}
<span class="pill">{{ text }}</span>
{% endmacro %}

{% macro contactCard(heading, eyebrow="", subtitle="", neutral=false) %}
<div class="contact-card{% if neutral %} contact-card--neutral{% endif %}">
  {% if eyebrow %}<div class="contact-card__eyebrow">{{ eyebrow }}</div>{% endif %}
  <h2>{{ heading | safe }}</h2>
  {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
  <div class="contact-card__actions">
    {{ caller() }}
  </div>
</div>
{% endmacro %}

{% macro dataRow(label, value) %}
<div class="data-row"><dt>{{ label }}</dt><dd>{{ value }}</dd></div>
{% endmacro %}

{% macro techToken(text, idx="", size="") %}
<span class="tok{% if size %} tok--{{ size }}{% endif %}">{{ text }}{% if idx %}<sup>{{ idx }}</sup>{% endif %}</span>
{% endmacro %}

{% macro timelineItem(when, role, org, desc) %}
<article class="tl-item">
  <p class="tl-when">{{ when }}</p>
  <div>
    <h3 class="tl-role">{{ role }}</h3>
    <p class="tl-org">{{ org }}</p>
    <p class="tl-desc">{{ desc | safe }}</p>
  </div>
</article>
{% endmacro %}
